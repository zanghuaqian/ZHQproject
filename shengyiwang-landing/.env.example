# 复制为 .env 后填写。不要把真实 corp secret 提交到 git。

# 1=强制本地 mock（不调企微）；留空则：配齐下面三项后自动走真接口
LEAD_MOCK=1
LEAD_PORT=8088
LEAD_HOST=0.0.0.0

# 查看留资列表 / 模拟扫码用。mock 模式下可不填（本地直接可调）
LEAD_ADMIN_TOKEN=change-me

# 手机号本地加密密钥，生产请换成足够长的随机串
LEAD_PHONE_KEY=change-this-phone-key

# —— 企业微信（真闭环必填）——
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_SALES_USERID=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_AGENT_ID=
WECOM_CALLBACK_URL=https://channelnotifytest.shengpay.com/wx/callback

# 客户联系标签 ID（在企微后台预先建好后填入）
WECOM_TAG_LEAD=
WECOM_TAG_PAY=
WECOM_TAG_HW=
WECOM_TAG_SAAS=
WECOM_TAG_AGENT=
WECOM_TAG_API=

# 活码池（生产建议 MIN=50 TARGET=200）
CODE_POOL_MIN=3
CODE_POOL_TARGET=5
